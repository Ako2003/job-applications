// Job Application Tracker — Prisma Schema
//
// Conventions:
// - Single user, but User table exists with one seeded row. Every entity carries
//   userId so that flipping to multi-user later is additive (no backfill).
// - All money stored as integer minor units (cents) + ISO 4217 currency string.
// - Application.status is a denormalized cache of the latest ApplicationEvent.
//   Update both in a transaction.
// - CV PDFs live in Cloudflare R2. Only the object key is stored here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum ApplicationStatus {
  DRAFT
  APPLIED
  SCREENING
  PHONE_INTERVIEW
  TECHNICAL_INTERVIEW
  ONSITE_FINAL
  OFFER
  REJECTED
  WITHDRAWN
  GHOSTED
}

enum Source {
  INDEED
  STEPSTONE
  GLASSDOOR
  XING
  LINKEDIN
  DJINNI
  COMPANY_WEBSITE
  REFERRAL
  RECRUITER_OUTREACH
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum RemotePolicy {
  ONSITE
  HYBRID
  REMOTE
}

enum EventType {
  APPLIED
  AUTO_REJECTED
  SCREENING_SCHEDULED
  SCREENING_DONE
  INTERVIEW_SCHEDULED
  INTERVIEW_DONE
  TECHNICAL_TASK_RECEIVED
  TECHNICAL_TASK_SUBMITTED
  OFFER_RECEIVED
  OFFER_NEGOTIATING
  OFFER_ACCEPTED
  OFFER_DECLINED
  REJECTED
  WITHDRAWN
  FOLLOW_UP_SENT
  GHOSTED
  NOTE
}

enum Language {
  EN
  DE
  RU
  FR
  AZ
  UK
  OTHER
}

enum DocumentType {
  COVER_LETTER
  RECOMMENDATION
  PORTFOLIO
  CERTIFICATE
}

// ---------- User (seeded with a single row) ----------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies    Company[]
  applications Application[]
  cvTemplates  CVTemplate[]
  contacts     Contact[]
  documents    Document[]
}

// ---------- Domain ----------

model Company {
  id        String   @id @default(cuid())
  userId    String
  name      String
  website   String?
  industry  String?
  sizeBand  String? // "1-10", "11-50", "51-200", "201-1000", "1000+"
  hqCity    String?
  hqCountry String? // ISO 3166-1 alpha-2
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  contacts     Contact[]

  @@unique([userId, name])
  @@index([userId])
}

model CVTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String // "Senior Frontend EN", "Full-stack DE v3"
  description String?
  language    Language

  // R2 storage: only the object key is stored. Signed URLs are generated on demand.
  storageKey  String   // e.g. "cvs/abc123.pdf"
  fileSize    Int? // bytes
  contentType String   @default("application/pdf")

  version    Int      @default(1)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId, isArchived])
}

model Application {
  id        String @id @default(cuid())
  userId    String
  companyId String

  role            String
  jobUrl          String?
  source          Source
  sourceListingId String? // board's own id when we can capture it

  location   String?
  country    String? // ISO 3166-1 alpha-2
  remote     RemotePolicy?
  employment EmploymentType?
  language   Language        @default(EN)

  // Money in minor units (e.g. cents). Currency ISO 4217.
  salaryMin Int?
  salaryMax Int?
  currency  String? // "EUR", "USD", "AZN", "UAH", etc.

  cvTemplateId String?
  coverLetter  String? @db.Text

  status       ApplicationStatus @default(APPLIED)
  appliedAt    DateTime          @default(now())
  nextActionAt DateTime?

  jobDescription  String?  @db.Text
  keyRequirements String[] // optional tech/skill bullets you record yourself
  notes           String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cvTemplate CVTemplate?        @relation(fields: [cvTemplateId], references: [id], onDelete: SetNull)
  events     ApplicationEvent[]
  contacts   Contact[]
  documents  Document[]

  @@index([userId, status])
  @@index([userId, appliedAt])
  @@index([companyId])
}

model ApplicationEvent {
  id            String    @id @default(cuid())
  applicationId String
  type          EventType
  occurredAt    DateTime  @default(now())
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
}

model Contact {
  id            String  @id @default(cuid())
  userId        String
  companyId     String
  applicationId String? // null = company-wide contact

  name        String
  role        String? // "Hiring Manager", "Recruiter", "Tech Lead"
  email       String?
  phone       String?
  linkedinUrl String?
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([companyId])
  @@index([applicationId])
}

model Document {
  id          String       @id @default(cuid())
  userId      String
  name        String
  description String?
  type        DocumentType

  // R2 storage: only the object key is stored. Signed URLs are generated on demand.
  storageKey  String       // e.g. "documents/cover_letter/abc123.pdf"
  fileSize    Int?         // bytes
  contentType String       @default("application/pdf")

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId, type])
}
