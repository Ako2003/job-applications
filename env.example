# --- Database (Neon, Frankfurt region) ---
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
# Direct connection used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# --- Auth (single user, custom) ---
# The password you'll enter at /login. Pick something strong.
APP_PASSWORD=""
# Used to sign the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# --- Seed user (read by prisma/seed.ts to create the single User row) ---
SEED_USER_EMAIL="you@example.com"
SEED_USER_NAME="Your Name"

# --- Storage (Cloudflare R2, private bucket) ---
# Cloudflare dashboard → R2 → Manage API tokens → Create token
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- Outbound email (Phase 2: reminders) ---
RESEND_API_KEY=""
REMINDER_FROM_EMAIL="reminders@yourdomain.com"
REMINDER_TO_EMAIL="you@example.com"

# --- App ---
# Used for absolute URLs (emails, redirects, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
